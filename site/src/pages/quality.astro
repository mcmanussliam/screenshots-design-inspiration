---
import Layout from '../layouts/main.astro';
import { products } from '../lib/catalog';

const screens = products.flatMap(product => product.screenshots);
const total = screens.length;
const dimensioned = screens.filter(screen => screen.width && screen.height).length;
const tagged = screens.filter(screen => screen.tags.length).length;
const documented = screens.filter(screen => screen.reviewStatus === 'source-documented').length;
const formatted = (count: number) => count.toLocaleString('en');
const percent = (count: number) => total ? Math.round(count / total * 1000) / 10 : 0;
const metrics = [
 { label: 'Products', value: formatted(products.length) },
 { label: 'Original screens', value: formatted(total) },
 { label: 'With verified dimensions', value: percent(dimensioned) + '%' },
 { label: 'With usable tags', value: percent(tagged) + '%' },
];
const guide = 'https://github.com/mcmanussliam/screenshots-design-inspiration/blob/main/contributing.md';
---
<Layout title="Dataset quality" description="Transparent information about screenshot coverage, provenance and curation priorities.">
 <section class="quality-hero">
  <h1>Dataset quality</h1>
  <p>See how much of the library has verified dimensions, usable tags and documented sources.</p>
 </section>
 <dl class="quality-metrics" aria-label="Current dataset statistics">
  {metrics.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
 </dl>
 <section class="quality-section">
  <h2>What the metadata tells us</h2>
  <p><b>{formatted(documented)} screenshots</b> have individually documented capture sources and rights evidence. The remaining <b>{formatted(total-documented)}</b> historical images are retained as legacy references, not automatically presented as openly licensed. This is a provenance audit gap, not a claim that any specific screenshot infringes copyright.</p>
  <p>Technical metadata includes actual original pixel width and height, file format and stored byte size. The gallery uses consistent aspect-aware frames while preserving the originals.</p>
 </section>
 <section class="quality-section">
  <h2>Help improve the library</h2>
  <p>Help verify tags, correct product metadata or document where a screenshot came from.</p>
  <a class="white-button" href={guide + '#reviewing-existing-data'}>How to contribute a correction</a>
 </section>
 <section class="quality-section">
  <h2>Tagging standards</h2>
  <p>Tags are separated into <b>screen types</b>, <b>UI elements</b>, <b>flows</b>, <b>UX patterns</b>, and <b>visual styles</b>. Synonyms are normalised and unknown legacy labels remain flagged for review. An automatically classified label is not considered human-verified without reviewing the underlying screenshot.</p>
  <p>Read <a href={guide + '#screen-tagging'}>the contribution guide</a> for evidence, resolution, naming and image-rights requirements.</p>
 </section>
</Layout>
