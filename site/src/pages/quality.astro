---
import Layout from '../layouts/main.astro';
import { base, products, productUrl, formatBytes } from '../lib/catalog';

const screens = products.flatMap(product => product.screenshots.map(screen => ({ product, screen })));
const total = screens.length;
const dimensioned = screens.filter(({ screen }) => screen.width && screen.height).length;
const documented = screens.filter(({ screen }) => screen.reviewStatus === 'source-documented').length;
const review = screens.filter(({ screen }) => !screen.tags.length);
const formatted = (count: number) => count.toLocaleString('en');
const percent = (count: number) => total ? Math.round(count / total * 1000) / 10 : 0;
const coverage = [
  { label: 'Verified dimensions', count: dimensioned },
  { label: 'Usable tags', count: total - review.length },
  { label: 'Documented sources', count: documented },
];
const repo = 'https://github.com/mcmanussliam/screenshots-design-inspiration';
---
<Layout title="Dataset quality" description="Screenshot coverage, provenance and curation priorities for Open Screens.">
 <div class="quality-dashboard">
  <section class="quality-masthead" aria-labelledby="quality-title">
   <div>
    <h1 id="quality-title">Dataset quality</h1>
    <p class="archive-deck">See how much of the archive has verified dimensions, useful tags, and a documented source.</p>
   </div>
   <a class="archive-action" href={base('') + '#browse'}>Browse the archive <span class="archive-arrow" aria-hidden="true"></span></a>
  </section>

  <section class="audit-overview" aria-labelledby="coverage-title">
   <div class="audit-inventory">
    <h2>Inventory</h2>
    <dl>
     <div><dt>Original screenshots</dt><dd>{formatted(total)}</dd></div>
     <div><dt>Products</dt><dd>{formatted(products.length)}</dd></div>
    </dl>
    <p>Original files retain their native resolution.</p>
   </div>
   <div class="audit-coverage">
    <h2 id="coverage-title">Metadata coverage</h2>
    {coverage.map(metric => (
     <div class="coverage-row">
      <div class="coverage-label">
       <span>{metric.label}</span>
       <strong>{percent(metric.count)}%</strong>
      </div>
      <meter min="0" max={total || 1} value={metric.count} aria-label={metric.label}></meter>
      <p>{formatted(metric.count)} of {formatted(total)} screenshots</p>
     </div>
    ))}
   </div>
  </section>

  <div class="audit-lower">
   <section class="audit-queue" id="review-queue" aria-labelledby="queue-title">
    <h2 id="queue-title">Review queue</h2>
    <p>{formatted(review.length)} screenshots need a usable tag. {review.length > 24 && 'Showing the first 24.'}</p>
    {review.length > 0 && (
     <table>
      <thead><tr><th scope="col">Product</th><th scope="col">Screenshot</th><th scope="col">Original file</th></tr></thead>
      <tbody>{review.slice(0, 24).map(({ product, screen }) => (
       <tr>
        <td><a href={productUrl(product)}>{product.name}</a></td>
        <td>{screen.name}</td>
        <td>
         {screen.width && screen.height && <span>{screen.width} × {screen.height} px</span>}
         <span>{formatBytes(screen.sizeBytes)}</span>
        </td>
       </tr>
      ))}</tbody>
     </table>
    )}
    <a class="archive-action" href={repo + '/issues/new/choose'} target="_blank" rel="noopener noreferrer">Suggest an entry or report a problem <span class="archive-arrow" aria-hidden="true"></span></a>
   </section>

   <aside class="audit-notes" aria-label="Archive standards">
    <section id="provenance">
     <h2>Image provenance</h2>
     <p><strong>{formatted(documented)}</strong> screenshots have documented capture sources and rights evidence. The other <strong>{formatted(total - documented)}</strong> are historical references with unverified provenance.</p>
     <p>Technical metadata records the original pixel dimensions, format, and file size. The repository’s <a href={repo + '/blob/main/data/curation-report.json'}>curation report</a> lists identical images across products for manual review.</p>
    </section>
    <section id="tagging-standards">
     <h2>Tagging standards</h2>
     <p>We group tags by screen type, UI element, flow, UX pattern, and visual style. Unknown legacy labels stay in review. Automatically classified tags need a person to check the underlying screenshot.</p>
     <a class="audit-guide" href={repo + '/blob/main/contributing.md'}>Read the contribution guide <span class="archive-arrow" aria-hidden="true"></span></a>
    </section>
   </aside>
  </div>
 </div>
</Layout>
