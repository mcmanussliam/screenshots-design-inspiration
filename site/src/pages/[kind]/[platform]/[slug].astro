---
import Layout from '../../../layouts/main.astro';
import {products,base,platformName,formatBytes,type Product} from '../../../lib/catalog';
export function getStaticPaths(){
 return products.map(product=>({params:{kind:product.kind==='app'?'apps':'sites',platform:product.platform,slug:product.slug},props:{product}}));
}
const {product}=Astro.props as {product:Product};
const isSite=product.kind==='site';
const screenTypeOptions=[...new Set(product.screenshots.flatMap(s=>s.tagGroups.screen))].sort();
---
<Layout title={product.name} description={'UI screenshots and patterns for '+product.name}>
 <section class="detail-header">
  <div class="detail-app-icon">
   {product.domain
    ?<img src={'https://www.google.com/s2/favicons?domain='+encodeURIComponent(product.domain)+'&sz=128'} alt={product.name+' icon'} loading="eager"/>
    :<span>{product.name.charAt(0).toUpperCase()}</span>}
  </div>
  <h1>{product.name} <span class="dash">—</span>
    {product.description&&<><br/><span class="detail-subtitle">{product.description}</span></>}
  </h1>
  <div class="detail-info">
   <dl class="detail-meta">
    <div><dt>Platform</dt><dd>{platformName(product.platform)}</dd></div>
    <div><dt>Category</dt><dd>{product.category}</dd></div>
    <div><dt>Screens</dt><dd>{product.screenshots.length}</dd></div>
   </dl>
   <div class="detail-actions"><button class="white-button" type="button" data-save={product.id}>♡ Save</button>
    <a class="ghost-button" href={base('saved/')}>My collections</a></div>
  </div>
  {product.source&&<details class="detail-patterns source-provenance"><summary>Source, attribution &amp; licence</summary>
    <p>{product.source.credit||'Captured from a documented source.'}</p>
    <div class="source-links">
      {product.source.page&&<a href={product.source.page} target="_blank" rel="noopener noreferrer">Original reference ↗</a>}
      {product.source.licenseEvidence&&<a href={product.source.licenseEvidence} target="_blank" rel="noopener noreferrer">Licence evidence ↗</a>}
    </div>
  </details>}
  {!product.source&&<p class="source-undocumented">Historical reference · Capture provenance and reuse rights not verified</p>}
  {product.tags.length>0&&<details class="detail-patterns"><summary>Explore {product.tags.length} tagged patterns</summary>
    <div class="detail-tags">{product.tags.map(t=><span>{t}</span>)}</div>
   </details>}
 </section>
 <section class="screens-section">
  <div class="screens-toolbar">
   <div class="screen-tabs"><span class="active">Screens</span>
    {product.videos.length>0&&<span class="screen-total">{product.videos.length} source recording{product.videos.length===1?'':'s'}</span>}
   </div>
   <div class="screen-toolbar-right">
    {screenTypeOptions.length>0&&<select id="screen-type-filter" aria-label="Filter by screen type"><option value="">All screen types</option>
      {screenTypeOptions.map(t=><option value={t}>{t}</option>)}</select>}
    <input id="screen-filter" type="search" placeholder="Filter screens or elements…" aria-label="Filter screenshots"/>
    <span class="screen-total">Showing {product.screenshots.length} screens</span>
   </div>
  </div>
  {product.videos.length>0&&<details class="recordings-section"><summary>View original motion recordings ({product.videos.length})</summary>
    <div class="recordings-grid">{product.videos.slice(0,12).map(v=>
     <div class="recording"><video muted loop playsinline preload="none" controls data-scroll-video>
      <source src={v.url} type={v.format==='webm'?'video/webm':'video/mp4'}/>
     </video><p>{v.name.replace(/\.(mp4|webm|mov)$/i,'').replaceAll('-',' ')} · {formatBytes(v.sizeBytes)}</p></div>
    )}</div>
   </details>}
  <div class:list={['screens-grid',{'screens-grid-wide':isSite}]} id="screens-grid">
   {product.screenshots.map((shot,i)=><div class="screen-item" data-shot-text={[shot.name,...shot.tags].join(' ').toLowerCase()} data-screen-types={shot.tagGroups.screen.join('|').toLowerCase()}>
    <button class="screen-open" type="button" data-preview={shot.url} data-caption={product.name+' · Screen '+(i+1)} aria-label={'Preview screen '+(i+1)}>
      <span class="screen-image-frame"><img class="shot-img" loading="lazy" decoding="async" src={shot.url} alt={product.name+' screen '+(i+1)} data-bytes={shot.sizeBytes??''} data-width={shot.width??''} data-height={shot.height??''}/></span>
    </button>
    <div class="screen-caption"><span>{shot.tagGroups.screen[0]||'Screen '+(i+1)}</span><span class="shot-dimensions" data-size-label>{shot.width&&shot.height?shot.width+' × '+shot.height:'Resolution on load'}</span></div>
    <div class="screen-extra">{formatBytes(shot.sizeBytes)}{shot.tagGroups.element[0]&&' · '+shot.tagGroups.element[0]}</div>
   </div>)}
  </div>
  <div id="no-screens" class="empty-state" hidden><h2>No matching screens</h2><p>Try another screen type or tag.</p></div>
 </section>
</Layout>
