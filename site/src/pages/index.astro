---
import Layout from '../layouts/main.astro';
import ProductCard from '../components/product-card.astro';
import {browseProducts, allTags} from '../lib/catalog';
const appCategories=[
 {title:'Categories',items:['Finance','Shopping','Food & Drink','Health & Fitness','Lifestyle']},
 {title:'Screens',items:['Login','Notifications','Dashboard','Signup','My Account & Profile']},
 {title:'UI Elements',items:['Stacked List','Bottom Sheet','Banner','Dropdown Menu','Text Field']},
 {title:'Flows',items:['Chatting & Sending Messages','Browsing Tutorial','Creating Account','Filtering & Sorting','Logging In']}
];
const siteCategories=[
 {title:'Categories',items:['Business','Finance','Technology','Social','Shopping']},
 {title:'Sections',items:['Footer','How It Works','FAQ','About','Blog']},
 {title:'UI Elements',items:['Social Proof','404','Hero','Features','Stats']},
 {title:'Styles',items:['Colorful','Dark','Photography','Motion','Illustration']}
];
const patterns=allTags.filter(x=>/login|dashboard|onboarding|signup|filter|form|modal|setting|home|search|card|button/i.test(x)).slice(0,70);
---
<Layout title="Browse interfaces">
 <section class="taxonomy taxonomy-landing" id="taxonomy-apps" aria-label="Browse apps by categories and patterns">
  {appCategories.map(c=><div class="taxonomy-col"><p class="taxonomy-title">{c.title}</p>{c.items.map(item=><button type="button" data-quick-search={item}>{item}</button>)}</div>)}
 </section>
 <section class="taxonomy taxonomy-landing" id="taxonomy-sites" aria-label="Browse websites by categories and patterns" hidden>
  {siteCategories.map(c=><div class="taxonomy-col"><p class="taxonomy-title">{c.title}</p>{c.items.map(item=><button type="button" data-quick-search={item}>{item}</button>)}</div>)}
 </section>
 <section class="browse-section" id="browse">
  <div class="browse-toolbar">
   <div class="browse-left"><div class="pill-group" role="group" aria-label="Type"><button type="button" data-kind="all" class="selected">All</button><button type="button" data-kind="app">Apps</button><button type="button" data-kind="site">Sites</button></div>
    <div class="pill-group" role="group" aria-label="Platform"><button type="button" data-platform="all" class="selected">All platforms</button><button type="button" data-platform="ios">iOS</button><button type="button" data-platform="android">Android</button><button type="button" data-platform="web">Web</button><button type="button" data-platform="email">Email</button></div>
    <span class="toolbar-sep"></span><button class="subtle-tab selected" type="button" data-sort="featured">Featured</button><button class="subtle-tab" type="button" data-sort="alpha">A–Z</button>
   </div>
   <button class="filter-button" type="button" id="toggle-filters" aria-expanded="false" aria-controls="filter-panel">☷ <span>Filter</span></button>
  </div>
  <div class="filter-panel" id="filter-panel" hidden><label for="tag-select">Screen or UI pattern</label><select id="tag-select"><option value="">All patterns</option>{patterns.map(tag=><option value={tag}>{tag}</option>)}</select><button type="button" id="reset-filters">Clear all filters</button></div>
  <div class="browse-summary"><span id="results-counter">{browseProducts.length} products</span><span>Browse interface screenshots.</span></div>
  <div class="product-grid" id="product-grid">{browseProducts.map(product=><ProductCard product={product}/>)}</div>
  <div id="no-matches" class="empty-state" hidden><div class="empty-illustration">⌕</div><h2>No interfaces found</h2><p>Try another search term or filter.</p></div>
 </section>
</Layout>
<script>
  function setHomeMode(siteMode:boolean){
    const app=document.getElementById('taxonomy-apps');
    const sites=document.getElementById('taxonomy-sites');
    const grid=document.getElementById('product-grid');
    if(app)app.hidden=siteMode;
    if(sites)sites.hidden=!siteMode;
    grid?.classList.toggle('sites-mode',siteMode);
  }
  setHomeMode(new URL(location.href).searchParams.get('view')==='sites');
  document.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach(button=>
    button.addEventListener('click',()=>setHomeMode(button.dataset.kind==='site')));
  document.getElementById('reset-filters')?.addEventListener('click',()=>setHomeMode(false));
</script>
