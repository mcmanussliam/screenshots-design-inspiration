---
import { base } from '../lib/catalog';

const repo = 'https://github.com/mcmanussliam/screenshots-design-inspiration';
---
<footer class="site-footer">
 <div class="footer-inner">
  <div class="footer-main">
   <div class="footer-about">
    <a class="footer-wordmark" href={base('')}>Open Screens</a>
    <p>A free, community-maintained library of interface screenshots.</p>
   </div>
   <nav aria-label="Library">
    <h2>Browse</h2>
    <a href={base('') + '?view=apps'}>Apps</a>
    <a href={base('') + '?view=sites'}>Sites</a>
    <a href={base('saved/')}>Saved collections</a>
   </nav>
   <nav aria-label="Project">
    <h2>Project</h2>
    <a href={base('quality/')}>Dataset quality</a>
    <a href={repo + '/blob/main/contributing.md'}>Contributing</a>
    <a href={repo}>GitHub</a>
   </nav>
  </div>
  <div class="footer-bottom">
   <p>Independent project. Screenshot rights belong to their respective owners.</p>
   <a href="#top">Back to top <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M6 10V2M2.5 5.5 6 2l3.5 3.5"/></svg></a>
  </div>
 </div>
</footer>

<style>
 .site-footer {
  border-top: 1px solid var(--stroke);
  background: #181819;
  color: #b3b3b5;
 }
 .footer-inner {
  max-width: 1760px;
  margin: 0 auto;
  padding: 42px clamp(22px, 4.7vw, 74px) 20px;
 }
 .footer-main {
  display: grid;
  grid-template-columns: minmax(0, 1.8fr) repeat(2, minmax(0, 1fr));
  gap: 26px 32px;
  padding-bottom: 36px;
 }
 .footer-wordmark {
  color: #f5f5f5;
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 750;
  letter-spacing: -.06em;
 }
 .footer-about p {
  max-width: 32ch;
  margin: 8px 0 0;
  font-size: 13px;
  line-height: 1.6;
 }
 nav { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
 nav h2 { margin: 2px 0 3px; color: #f5f5f5; font-size: 12px; font-weight: 700; }
 nav a, .footer-bottom a { font-size: 13px; }
 .site-footer a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
 .footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10px 20px;
  border-top: 1px solid var(--stroke);
  padding-top: 17px;
  font-size: 12px;
 }
 .footer-bottom p { margin: 0; line-height: 1.55; }
 .footer-bottom a { display: inline-flex; align-items: center; gap: 6px; }
 @media (max-width: 650px) {
  .footer-inner { padding: 30px 18px 18px; }
  .footer-main { grid-template-columns: repeat(2, minmax(0, 1fr)); padding-bottom: 25px; }
  .footer-about { grid-column: 1 / -1; }
 }
</style>
