---
import { base } from '../lib/catalog';

const repo = 'https://github.com/mcmanussliam/screenshots-design-inspiration';
---
<footer class="site-footer" id="site-footer">
 <div class="footer-inner">
  <nav aria-label="Footer">
   <a href={base('quality/')}>Dataset quality</a>
   <a href={repo + '/blob/main/contributing.md'}>Contributing</a>
   <a href={repo}>GitHub</a>
  </nav>
  <p>Screenshot rights belong to their respective owners.</p>
  <a class="footer-top" href="#top">Back to top</a>
 </div>
</footer>

<style>
 .site-footer {
  border-top: 1px solid var(--stroke);
  color: #a8a8aa;
  font-size: 12px;
  scroll-margin-top: 80px;
 }
 .footer-inner {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: baseline;
  gap: 12px 24px;
  max-width: 1760px;
  margin-inline: auto;
  padding: 21px clamp(22px, 4.7vw, 74px) 24px;
 }
 nav { display: flex; flex-wrap: wrap; gap: 9px 17px; }
 p { margin: 0; line-height: 1.5; text-align: center; }
 a { color: #dedee0; }
 a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
 .footer-top { white-space: nowrap; }
 @media (max-width: 700px) {
  .footer-inner { grid-template-columns: 1fr auto; gap: 10px 15px; padding-inline: 18px; }
  nav { grid-column: 1 / -1; }
  p { text-align: left; }
 }
</style>
