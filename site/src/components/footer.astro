---
import { base } from '../lib/catalog';

const repo = 'https://github.com/mcmanussliam/screenshots-design-inspiration';
---
<footer class="site-footer" id="site-footer">
 <div class="footer-inner">
  <div class="footer-main">
   <div class="footer-about">
    <p>A free, community-maintained library of interface screenshots.</p>
    <a class="footer-explore" href={base('') + '#browse'}>Explore the library
     <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 8h11m-4-4 4 4-4 4"/></svg>
    </a>
   </div>
   <nav aria-label="Library">
    <h2>Browse</h2>
    <a href={base('') + '?view=apps'}>Apps</a>
    <a href={base('') + '?view=sites'}>Sites</a>
    <a href={base('saved/')}>Saved collections</a>
   </nav>
   <nav aria-label="Project">
    <h2>Project</h2>
    <a href={base('quality/')}>Dataset quality</a>
    <a href={repo + '/blob/main/contributing.md'}>Contributing</a>
    <a href={repo}>GitHub</a>
   </nav>
  </div>
  <a class="footer-signature" href={base('')}>
   <span>Open Screens</span>
   <span class="brand-mark footer-mark" aria-hidden="true"><i></i><i></i><i></i></span>
  </a>
  <div class="footer-bottom">
   <p>Independent project. Screenshot rights belong to their respective owners.</p>
   <a href="#top">Back to top <svg width="13" height="13" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M6 10V2M2.5 5.5 6 2l3.5 3.5"/></svg></a>
  </div>
 </div>
</footer>

<style>
 .site-footer {
  border-top: 1px solid var(--stroke);
  background: #1b1b1d;
  color: #b7b7b9;
  scroll-margin-top: 78px;
 }
 .footer-inner {
  max-width: 1760px;
  margin: 0 auto;
  padding: clamp(26px, 4vw, 54px) clamp(22px, 4.7vw, 74px) 0;
 }
 .footer-main {
  display: grid;
  grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
  gap: 23px 26px;
  padding-bottom: clamp(24px, 3vw, 40px);
 }
 .footer-about p {
  max-width: 29ch;
  margin: 0 0 15px;
  color: #eeeeef;
  font-size: clamp(17px, 2vw, 25px);
  font-weight: 570;
  line-height: 1.28;
  letter-spacing: -.033em;
 }
 .footer-explore { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 650; }
 nav { display: flex; flex-direction: column; align-items: flex-start; gap: 9px; padding-left: 18px; border-left: 1px solid var(--stroke); }
 nav h2 {
  margin: 0 0 4px;
  font: 11px/1.4 ui-monospace, monospace;
  letter-spacing: .07em;
  text-transform: uppercase;
 }
 nav a { color: #eeeeef; font-size: 14px; }
 .site-footer a:not(.footer-signature):hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
 .footer-signature {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: clamp(10px, 2vw, 25px) 0 clamp(14px, 2.3vw, 31px);
  border-block: 1px solid var(--stroke);
  color: #eeeeef;
  font-size: clamp(34px, 10.6vw, 181px);
  font-weight: 750;
  line-height: .98;
  letter-spacing: -.085em;
 }
 .footer-signature:hover { color: #fff; }
 .footer-signature .footer-mark {
  width: auto;
  height: auto;
  gap: .06em;
  margin-right: .06em;
  font-size: .76em;
 }
 .footer-signature .footer-mark i { width: .33em; height: .51em; background: currentColor; }
 .footer-signature .footer-mark i:nth-child(2) { height: .64em; }
 .footer-signature .footer-mark i:nth-child(3) { height: .39em; }
 .footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8px 20px;
  padding: 15px 0 18px;
  font-size: 12px;
 }
 .footer-bottom p { margin: 0; line-height: 1.55; }
 .footer-bottom a { display: inline-flex; align-items: center; gap: 7px; }
 @media (max-width: 650px) {
  .footer-inner { padding-inline: 18px; }
  .footer-main { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .footer-about { grid-column: 1 / -1; }
  nav { padding-left: 10px; }
 }
</style>
