---
import { base } from '../lib/catalog';
import Stamp from './stamp.astro';

const repo = 'https://github.com/mcmanussliam/screenshots-design-inspiration';
---
<footer class="site-footer" id="site-footer">
 <div class="footer-inner">
  <div class="footer-main">
   <div class="footer-intro">
    <a class="footer-stamp" href={base('')} aria-label="Home"><Stamp /></a>
    <p>A free library of interface screenshots from real apps and websites.</p>
   </div>
   <div class="footer-links">
    <nav aria-label="Library">
     <h2>Browse</h2>
     <a href={base('') + '?view=apps'}>Apps</a>
     <a href={base('') + '?view=sites'}>Sites</a>
     <a href={base('saved/')}>Saved collections</a>
    </nav>
    <nav aria-label="Project">
     <h2>Project</h2>
     <a href={base('quality/')}>Dataset quality</a>
     <a href={repo + '/blob/main/contributing.md'}>Contributing</a>
     <a href={repo}>GitHub</a>
    </nav>
   </div>
  </div>
  <div class="footer-bottom">
   <p>Independent project. Screenshot rights belong to their respective owners.</p>
   <a class="footer-top" href="#top">Back to top
    <svg width="13" height="13" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M6 10V2M2.5 5.5 6 2l3.5 3.5"/></svg>
   </a>
  </div>
 </div>
</footer>

<style>
 .site-footer {
  border-top: 1px solid var(--stroke);
  background: #181819;
  color: #a8a8aa;
  scroll-margin-top: 78px;
 }
 .footer-inner {
  max-width: 1760px;
  margin-inline: auto;
  padding-inline: clamp(22px, 4.7vw, 74px);
 }
 .footer-main {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  gap: 28px clamp(24px, 5vw, 70px);
  padding-block: clamp(26px, 3.6vw, 46px);
 }
 .footer-intro { display: flex; align-items: center; gap: 18px; }
 .footer-intro p {
  max-width: 24ch;
  margin: 0;
  color: #e4e4e6;
  font-size: clamp(15px, 1.6vw, 20px);
  line-height: 1.4;
  letter-spacing: -.025em;
 }
 .footer-stamp {
  --stamp-size: 58px;
  display: grid;
  flex: none;
  width: 76px;
  aspect-ratio: 1;
  place-items: center;
  border: 1px solid var(--stroke);
  border-radius: 8px;
  background: #202021;
  color: #f5f5f5;
 }
 .footer-stamp:hover { border-color: #666669; background: #262627; }
 .footer-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
 nav { display: grid; align-content: start; justify-items: start; gap: 9px; }
 nav h2 {
  width: 100%;
  margin: 0 0 3px;
  padding-bottom: 9px;
  border-bottom: 1px solid var(--stroke);
  font: 11px/1.4 ui-monospace, monospace;
  letter-spacing: .07em;
  text-transform: uppercase;
 }
 nav a { color: #e4e4e6; font-size: 14px; }
 nav a:hover, .footer-top:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
 .footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px 20px;
  padding-block: 13px;
  border-top: 1px solid var(--stroke);
  font-size: 12px;
 }
 .footer-bottom p { margin: 0; line-height: 1.55; }
 .footer-top { display: inline-flex; align-items: center; gap: 7px; padding-block: 6px; }
 @media (max-width: 650px) {
  .footer-inner { padding-inline: 18px; }
  .footer-main { grid-template-columns: 1fr; }
  .footer-stamp { --stamp-size: 47px; width: 62px; }
 }
</style>
